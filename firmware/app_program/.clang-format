# Layout rules from the Barr Group Embedded C Coding Standard (BARR-C:2018).
# Applies to our code in firmware/app_program (and tests/); the kernel keeps
# its own style.  Run tools/barr_c_format.sh rather than clang-format alone:
# it also applies what clang-format cannot express (constant-left equality
# tests, break aligned with case, end-of-file marker).  See
# docs/CODING_STANDARD.md.
Language: Cpp
BasedOnStyle: LLVM

# 1.2.a  Lines are at most 80 characters.
ColumnLimit: 80
# 3.4.a  Indent in multiples of 4; 3.5.a no tab characters.
IndentWidth: 4
ContinuationIndentWidth: 4
UseTab: Never
# 3.6.a  Unix line endings.
LineEnding: LF

# 1.3.a  Braces around every block; 1.3.b each brace on its own line.
BreakBeforeBraces: Allman
InsertBraces: true
AllowShortBlocksOnASingleLine: Never
AllowShortCaseLabelsOnASingleLine: false
AllowShortEnumsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false

# 3.4.b  Case labels aligned and indented one level inside the switch.
IndentCaseLabels: true

# 3.1.e  Pointer operators spaced on both sides in declarations.
PointerAlignment: Middle
# 3.1.j  One space between the function name and "(" in its definition only.
SpaceBeforeParens: Custom
SpaceBeforeParensOptions:
  AfterControlStatements: true
  AfterFunctionDeclarationName: true
  AfterFunctionDefinitionName: true
SpaceAfterCStyleCast: true

# 3.2.a-c  Align declarations, struct members, assignments and macros.
AlignConsecutiveDeclarations: Consecutive
AlignConsecutiveAssignments: Consecutive
AlignConsecutiveMacros: Consecutive
AlignTrailingComments: true

# 3.2.d  The '#' of every preprocessor directive stays in column 1.
IndentPPDirectives: None

# 3.3.b  Keep the blank lines that separate natural blocks of code.
MaxEmptyLinesToKeep: 1
KeepEmptyLinesAtTheStartOfBlocks: false

# Include order can matter (tk/tkernel.h before others), so leave it alone.
SortIncludes: Never
ReflowComments: true
BinPackArguments: true
BinPackParameters: true
AlignAfterOpenBracket: Align
